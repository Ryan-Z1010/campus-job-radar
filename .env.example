# Copy this file to .env locally. Never commit real credentials.
ALERT_EMAIL=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_USE_SSL=true

# Optional: only needed by the local `job-radar llm-analyze` command.
# Never commit a real API key. The daily GitHub monitor does not use these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
